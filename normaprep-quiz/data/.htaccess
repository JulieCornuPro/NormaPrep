# Le dossier data/ contient les banques de questions AVEC leurs réponses et
# leurs explications : c'est le contenu payant de NormaPrep. Seul l'importeur
# le lit, en PHP, directement sur le disque — aucun navigateur n'a à y accéder.
#
# Sans cette règle, un visiteur anonyme pouvait télécharger chaque fichier à
# l'adresse /wp-content/plugins/normaprep-quiz/data/…, et cette adresse est
# visible dans le code source de n'importe quelle page du site.
#
# Les deux syntaxes couvrent Apache 2.4 et les serveurs restés en 2.2.
#
# ATTENTION : ce fichier n'a d'effet que sous Apache ou LiteSpeed. Sous Nginx,
# il est ignoré sans le moindre avertissement. La page d'import de NormaPrep
# vérifie donc, à chaque affichage, que le dossier est réellement protégé.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
